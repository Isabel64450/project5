{% extends 'base.html.twig' %}

{% block title %}Product index{% endblock %}

{% block body %}
<div class="container">

    <h1>Product index</h1>


    <table class="table">
        <thead>
            <tr>
               
                <th>Name</th>
                <th>Description</th>
                <th>Price</th>
                <th>category</th> 
                <th>stock</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for product in products %}
            <tr>
                
                <td>{{ product.name }}</td>
                <td>{{ product.description|slice(0,100) }} ...</td>
                <td>{{ product.price }}</td>
                <td>{% for subCategory in product.subCategory %}
                    {{ subCategory.name }}<br>
                {% else %}
                    Aucune
                {% endfor %}
                </td>
                 <td>
                    {% if product.stock > 0  %}
                        {{ product.stock }}
                        
                    {% else %}
                        <span class="text-danger">Stock épuisé</span>
                    {% endif %}
                </td>
                <td>
                    <a class="btn btn-primary" href="{{ path('app_product_show', {'id': product.id}) }}">show</a>
                    <a class="btn btn-outline-success" onclick=" return confirm('Voulez vous vraiment modifier le produit ?')" href="{{ path('app_product_edit', {'id': product.id}) }}">edit</a>
                    <a class="btn btn-outline-info" href="{{ path('app_product_stock_add', {'id': product.id}) }}">Ajouter du stock</a>    
                </td>
            </tr>
                    
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_product_new') }}">Create new</a>
    </div>
{% endblock %}
