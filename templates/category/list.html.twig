{% extends 'base.html.twig' %}

{% block title %}Liste des categories{% endblock %}

{% block body %}
<div class="container mt-4">
    <h2 class="mb-4">Liste des categories</h2>

     {% include 'layouts/_flash_message.html.twig' %}

    <div class="table-responsive-lg"> 
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    {# <th>ID</th> #}
                    <th>Name</th>
                    <th>Actions</th> 
                </tr>
            </thead>
            <tbody>
                {% for category in categories %}
                    <tr>
                       {#  <td>{{ category.id }}</td> #}
                        <td>{{ category.name }}</td>
                        <td>
                            <a href="{{ path('app_category_edit', {'id': category.id}) }}" 
                               class="btn btn-outline-primary">
                                Edit
                            </a>
                            <a onclick= "return confirm('Voulez vous vraiment supprimer cette catégorie ?')" href="{{ path('app_category_delete', {'id': category.id}) }}" 
                               class="btn btn-danger">
                                Delete
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3" class="text-center">
                            Aucune catégorie trouvée
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
      <a href="{{ path('app_category_new') }}" class= 'btn btn-success'>Add a new category</a>
</div>
{% endblock %}