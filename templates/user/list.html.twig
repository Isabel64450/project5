{% extends 'base.html.twig' %}

{% block title %}Liste des utilisateurs{% endblock %}

{% block body %}
<div class="container mt-4">
    <h2 class="mb-4">Liste des utilisateurs</h2>

    {% include 'layouts/_flash_message.html.twig' %}

   
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>lastName</th>
                <th>Email</th>
                <th>Rôles</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for user in users %}
                <tr>
                    <td>{{ user.firstName }}</td>
                    <td>{{ user.lastName }}</td>
                    <td>{{ user.userIdentifier }}</td>
                    <td>{% if ('ROLE_ADMIN' in user.roles) %}
                        <span class="text-primary">Administrateur</span> 
                    {% elseif ('ROLE_EDITOR' in user.roles) %}
                         <span class="text-success">Editeur</span> 
                    {% else %}
                         <span class="text-secondary">Client</span> 
                    {% endif %}
                        </td>
                    <td>
                         {% if ('ROLE_ADMIN' in user.roles) == false %}
                            {% if ('ROLE_EDITOR' in user.roles) == false %}
                                 <a onclick= "return confirm('Voulez vous vraiment affecter ce rôle à ce user ?')" class="btn btn-outline-primary" href="{{ path('app_user_make_editor', {'id': user.id, 'role': 'ROLE_EDITOR'}) }}">Ajouter le rôle éditeur</a> 
                            {% else %}
                                  <a onclick= "return confirm('Voulez vous vraiment retirer ce rôle à ce user ?')" class="btn btn-outline-danger" href="{{ path('app_user_delete_editor_role', {'id':user.id}) }}" >Retirer le rôle éditeur</a>
                            {% endif %}
                            <a onclick= "return confirm('Voulez vous vraiment supprimer cet utilisateur ?')" href="{{ path('app_user_remove', {'id':user.id}) }}" class="btn btn-danger">Supprimer</a>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4" class="text-center">Aucun utilisateur trouvé</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}