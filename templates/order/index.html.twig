$(function(){

    const citySelector = $('#order_city');
    function updateShipping(cityId) {
        $.ajax({
            url: `/city/${cityId}/shipping/cost`,
            type: 'GET',
            dataType: 'json', 
            success: function(response) {
                if (response.status === 200) {                
                    $('#shippingCost').text(response.content);                  
                    const cardPrice = parseFloat($('#card-price').text()) || 0;
                    const shippingCost = parseFloat(response.content) || 0;
                    $('.total-price').text(cardPrice + shippingCost);
                }
            },

            error: function() {
                console.error('Erreur lors du calcul du shipping');
            }
        });
    }

      if (citySelector.length) {
        updateShipping(citySelector.val());
    }

        citySelector.on('change', function(){
        updateShipping($(this).val());
    });

});


















</script>
