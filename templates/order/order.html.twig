{% extends 'base.html.twig' %}
{% block body %}

<div class="container mt-5">
    <h1 class="mb-4">Commandes</h1>

    {% for order in orders %}
        <div class="card mb-4 shadow-sm">
            
             <div class="card-header bg-primary text-white d-flex justify-content-between">
                <span>Commande #{{ order.id }}</span>
                <span>{{ order.createdAt|date('d/m/Y H:i') }}</span>
            </div>

            <div class="card-body">
                <div class="row">
                    
                 
                    <div class="col-md-6">
                        <h5>Client</h5>
                        <p><strong>Nom :</strong> {{ order.firstName }} {{ order.lastName }}</p>
                        <p><strong>Téléphone :</strong> {{ order.telephoneNumber }}</p>
                        <p><strong>Adresse :</strong> {{ order.address }}</p>
                        <p><strong>Ville :</strong> {{ order.city.name ?? 'Non définie' }}</p>
                    </div>

                        <div class="col-md-6">
                        <h5>Détails</h5>
                        <p>
                            {# <strong>Paiement :</strong>
                            <span class="badge bg-{{ order.payOnDelivery ? 'warning' : 'success' }}">
                                {{ order.payOnDelivery ? 'À la livraison' : 'Payé' }}
                            </span> #}
                        </p>
                        <p><strong>Total :</strong> {{ order.totalPrice }} €</p>
                    </div>
                </div>

                <hr>

               
                <h5>Produits</h5>

                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Image</th>
                                <th>Produit</th>
                                <th>Prix</th>
                                <th>Quantité</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for op in order.orderProducts %}
                                <tr>
                                    <td style="width: 80px;">
                                        <img src="/uploads/images/{{ op.product.images }}" 
                                             class="img-fluid rounded"
                                             alt="{{ op.product.name }}">
                                    </td>

                                    <td>{{ op.product.name }}</td>
                                    <td>{{ op.product.price }} €</td>
                                    <td>{{ op.quantity }}</td>
                                    <td>{{ op.product.price * op.quantity }} €</td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="5" class="text-center text-muted">
                                        Aucun produit
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    {% else %}
        <div class="alert alert-info">
            Aucune commande trouvée
        </div>
    {% endfor %}
</div>


{% endblock %}